# ShadowGuard application configuration
# Copy this file to .env.local for local development. Never commit real secrets.

# ── Required: application origin ────────────────────────────────────
# Set both values to the exact public origin. NEXT_PUBLIC_* values are embedded
# by `next build`, so provide them while building the production image.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Required: Supabase ──────────────────────────────────────────────
# Local CLI defaults are printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never use this key in browser code or expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: Google Workspace discovery ────────────────────────────
# Leave all Google values empty to use manual governance workflows only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Optional: Microsoft 365 discovery ───────────────────────────────
# Leave all Microsoft values empty to use manual governance workflows only.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ── Optional: encrypted integration credentials ─────────────────────
# Required only when storing Google/Microsoft OAuth credentials.
# Generate a 32-byte base64 key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# During a deliberate key rotation, temporarily provide the prior key/version.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
TOKEN_ENCRYPTION_KEY_PREVIOUS_VERSION=

# Required only for AgentGuard HTTPS export destinations or Slack previews.
# Generate an independent high-entropy secret; do not reuse the token key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_GUARD_EXPORT_SECRET_KEY=

# ── Optional: shared rate limiting ──────────────────────────────────
# Without both values, the app uses a process-local in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional: Cloudflare Turnstile ──────────────────────────────────
# Also configure the matching secret in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Optional: distribution branding ─────────────────────────────────
# Supported values: shadowguard (default) or agentguard.
NEXT_PUBLIC_BRAND=shadowguard

# Supabase Auth URL checklist for this local example:
#   Site URL: http://localhost:3000
#   Redirect URL: http://localhost:3000/auth/callback
#   Redirect URL: http://localhost:3000/login/reset-password
#
# Production operators must replace localhost with their own HTTPS origins in
# this file, their image build environment, Supabase Auth, and OAuth providers.
